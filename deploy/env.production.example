APP_NAME="Tech-Sphere Wi-fi Billing System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.20.253
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=sw
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# install.sh inajaza sehemu hizi yenyewe.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techsphere_wifi
DB_USERNAME=techsphere
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Malipo
HOTSPOT_PAYMENT_PROVIDER=clickpesa
HOTSPOT_PAYMENT_TIMEOUT=120
HOTSPOT_SIMULATED_PAYMENT_DELAY=8

# ClickPesa — nakili thamani halisi kutoka .env ya PC ya sasa.
CLICKPESA_SANDBOX=false
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=
CLICKPESA_CHECKSUM_ENABLED=true

# Acha wazi. Seva ina IP moja tu kwenye LAN ya MikroTik, hivyo PHP itachagua
# njia sahihi yenyewe.
MIKROTIK_BIND_IP=
